{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Rivestor Docs",
  "colors": {
    "primary": "#4C1D95",
    "light": "#B197E6",
    "dark": "#4C1D95"
  },
  "background": {
    "color": {
      "light": "#FAF9FC",
      "dark": "#0B0A10"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "concepts"
            ]
          },
          {
            "group": "Account",
            "icon": "user-shield",
            "pages": [
              "account/create-account",
              "account/verification",
              "account/security"
            ]
          },
          {
            "group": "Investing",
            "icon": "chart-line",
            "pages": [
              "investing/portfolios",
              "investing/deposits-withdrawals"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "icon": "code",
            "pages": [
              "api/overview",
              "api/authentication",
              "api/errors"
            ]
          }
        ]
      },
      {
        "tab": "Resources",
        "groups": [
          {
            "group": "Help",
            "icon": "life-ring",
            "pages": [
              "resources/faq",
              "resources/support"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@rivestor.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Rivestor",
      "href": "https://rivestor.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
