{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Rivestor Docs",
  "colors": {
    "primary": "#4C1D95",
    "light": "#B197E6",
    "dark": "#4C1D95"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://rivestor.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:vs@rivestor.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://rivestor.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/rivestor",
      "website": "https://rivestor.com/",
      "instagram": "https://instagram.com/rivestor",
      "telegram": "https://t.me/rivestor"
    }
  },
  "description": "Official documentation for Rivestor",
  "icons": {
    "library": "lucide"
  },
  "background": {
    "color": {
      "light": "#FAF9FC",
      "dark": "#0B0A10"
    }
  },
  "fonts": {
    "family": "Inter"
  },
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  }
}
