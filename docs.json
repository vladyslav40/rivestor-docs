{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Rivestor Docs",
  "colors": {
    "primary": "#4C1D95",
    "light": "#B197E6",
    "dark": "#4C1D95"
  },
  "background": {
    "color": {
      "light": "#FAF9FC",
      "dark": "#0B0A10"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "favicon": {
    "light": "https://rivestor.com/images/rivv.svg",
    "dark": "https://rivestor.com/images/rivv.svg"
  },
  "logo": {
    "light": "https://rivestor.com/images/blogo.webp",
    "dark": "https://rivestor.com/images/rivestor-logo.png",
    "href": "https://rivestor.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "concepts"
            ]
          },
          {
            "group": "Account",
            "icon": "shield-check",
            "pages": [
              "account/create-account",
              "account/verification",
              "account/security"
            ]
          },
          {
            "group": "Investing",
            "icon": "chart-line",
            "pages": [
              "investing/portfolios",
              "investing/deposits-withdrawals"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "Overview",
            "icon": "code",
            "pages": [
              "api/overview",
              "api/authentication",
              "api/errors"
            ]
          }
        ]
      },
      {
        "tab": "Resources",
        "groups": [
          {
            "group": "Help",
            "icon": "life-buoy",
            "pages": [
              "resources/faq",
              "resources/support"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:vs@rivestor.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://rivestor.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "description": "Official documentation for Rivestor",
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "family": "Inter"
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/rivestor",
      "website": "https://rivestor.com/",
      "instagram": "https://instagram.com/rivestor",
      "telegram": "https://t.me/rivestor"
    }
  }
}
