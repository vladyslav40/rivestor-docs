{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Rivestor Docs",
  "colors": {
    "primary": "#4C1D95",
    "light": "#B197E6",
    "dark": "#4C1D95"
  },
  "background": {
    "color": {
      "light": "#FAF9FC",
      "dark": "#0B0A10"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "favicon": {
    "light": "https://rivestor.com/images/rivv.svg",
    "dark": "https://rivestor.com/images/rivv.svg"
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png",
    "href": "https://rivestor.com"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "Introduction",
            "icon": "compass",
            "pages": [
              "index",
              "status",
              "how-it-works"
            ]
          },
          {
            "group": "Core concepts",
            "icon": "book-open",
            "pages": [
              "concepts/rtokens",
              "concepts/dual-engine",
              "concepts/glossary"
            ]
          }
        ]
      },
      {
        "tab": "Investors",
        "groups": [
          {
            "group": "Get started",
            "icon": "user-check",
            "pages": [
              "investors/getting-started",
              "investors/asset-classes"
            ]
          },
          {
            "group": "Trade and earn",
            "icon": "arrow-right-left",
            "pages": [
              "investors/buying-and-trading",
              "investors/income-distributions",
              "investors/exiting-positions"
            ]
          },
          {
            "group": "Risk",
            "icon": "triangle-alert",
            "pages": [
              "investors/risks"
            ]
          }
        ]
      },
      {
        "tab": "Issuers",
        "groups": [
          {
            "group": "List an asset",
            "icon": "building-2",
            "pages": [
              "issuers/overview",
              "issuers/direct-tokenization",
              "issuers/listing-tracks",
              "issuers/token-wrapping"
            ]
          },
          {
            "group": "Economics",
            "icon": "receipt",
            "pages": [
              "issuers/fees"
            ]
          }
        ]
      },
      {
        "tab": "Protocol",
        "groups": [
          {
            "group": "Architecture",
            "icon": "blocks",
            "pages": [
              "protocol/architecture",
              "protocol/programs",
              "protocol/token-extensions"
            ]
          },
          {
            "group": "Compliance and settlement",
            "icon": "shield-check",
            "pages": [
              "protocol/compliance-hook",
              "protocol/settlement-and-venue",
              "protocol/security-and-governance"
            ]
          },
          {
            "group": "Integration",
            "icon": "plug",
            "pages": [
              "protocol/embedded-sdk",
              "protocol/stage-3-modules"
            ]
          }
        ]
      },
      {
        "tab": "Legal and compliance",
        "groups": [
          {
            "group": "Investor protection",
            "icon": "landmark",
            "pages": [
              "legal/three-pillars",
              "legal/spv-structure",
              "legal/title-protection",
              "legal/security-trustee"
            ]
          },
          {
            "group": "Regulation",
            "icon": "scale",
            "pages": [
              "legal/jurisdictions",
              "legal/regulatory-approach",
              "legal/risk-matrix",
              "legal/disclaimer"
            ]
          }
        ]
      },
      {
        "tab": "Resources",
        "groups": [
          {
            "group": "Help",
            "icon": "life-buoy",
            "pages": [
              "resources/comparison",
              "resources/faq",
              "resources/support"
            ]
          }
        ]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:vs@rivestor.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch App",
      "href": "https://rivestor.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "description": "Official documentation for Rivestor",
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "family": "Inter"
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/rivestor",
      "website": "https://rivestor.com/",
      "instagram": "https://instagram.com/rivestor",
      "telegram": "https://t.me/rivestor"
    }
  }
}
